#!/bin/sh
# File generated by nmo-sdk-config
# Mer  2 oct 2002 19:29:38 CEST

prefix=/home/henri/nmo-sdk

#--------------------------------------------
ac_prev=
for ac_option
do
	if [ -n "$ac_prev" ]
	then
		eval "$ac_Prev=\$ac_option"
		ac_prev=
		continue
	fi

	case "$ac_option" in
	-*=*) ac_optarg=`echo "$ac_option" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
	*) ac_optarg= ;;
	esac

	case "$ac_option" in
	-help | --help | -\? | --h | -h)
		cat << EOF
Usage: configure [options]
Options: [defaults in brackets after descriptions]
    --help                  print this message.
    --prefix=DIRECTORY      use this directory for installation.
                            [$prefix]
EOF
		exit 0;
		;;
	--prefix=*)
		prefix=$ac_optarg
		;;	
	*)
		echo "Invalid option, try --help"
		exit 0
		;;
	esac

done

allfiles=`find . -name Makefile.in`
nmomk=`nmo-sdk-config --makefile`

for filename in $allfiles; do
    thedir=`dirname $filename`
    echo "creating $thedir/Makefile..."
    rm -f $thedir/Makefile
    cat > $thedir/Makefile <<EOF
include $nmomk
prefix=$prefix

EOF
cat $thedir/Makefile.in >> $thedir/Makefile
touch $thedir/.depend
done
