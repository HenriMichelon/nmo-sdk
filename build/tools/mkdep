D=.depend			# default dependency file is .depend
CC=${CC-"gcc"}

while :
	do case "$1" in
		# -f allows you to select a makefile name
		-f)
			D=$2
			shift; shift ;;
		-d)
			SRCDIR="$SRCDIR $2"
			shift; shift ;;
		-r)
			REMDIR="$REMDIR $2"
			shift; shift ;;
		-cc)
			CC=$2
			shift; shift ;;
		*)
			break ;;
	esac
done

case $# in 0) 
	echo 'usage: mkdep [-d directory] [ -r directory] [-f file] [flags] file ...' >&2
	
esac

TMP=_mkdep$$
trap 'rm -f $TMP; trap 2 ; kill -2 $$' 1 2 3 13 15
trap 'rm -f $TMP' 0

if $CC -w -E -M -MG "$@" >> $TMP; then :
else
	echo 'mkdep: compile failed' >&2
	exit 1
fi

# Lines below added 26 Aug 2001 by hmichelon

# replace target by path/target
sed 's/^.*: \([^\.]*\).c\([p]*\)/\1.o: \1.c\2 /g' < $TMP > $D

# hack to reduce size (50%) of the .depend file
# when compiling the NMO-SDK
alldirs=`echo $SRCDIR | sed 's/-I\//\//g'`
alldirs=`echo $alldirs | sed 's/\//\\\\\//g'`
for thedir in $alldirs; do
	mv -f $D $TMP
	sed "s/$thedir\///g" < $TMP > $D
done

# hack to remove real "standard" includes
alldirs=`echo $REMDIR | sed 's/-I\//\//g'`
alldirs=`echo $alldirs | sed 's/\//\\\\\//g'`
for thedir in $alldirs; do
	mv -f $D $TMP
	sed "s/\($thedir[^ ]*[ ]*\)//g" < $TMP > $D
done

mv $D $TMP
grep -v '^[ ]*\\' $TMP > $D

exit $?
