# $Id: nmo-sdk-config.in,v 1.1.1.1 2002/11/03 19:18:16 hmichelon Exp $

usage()
{
		cat << EOF
Usage: nmo-sdk-config [options]
Options: 
    --help          print this message
    --version       print the version of configure
    --prefix        print the nmo-sdk installation directory
    --makefile      print the Makefile.nmo.mk location for
                    including it into your Makefiles
    --generate      generate a sample configure script
                    and a sample Makefile.in
EOF
	exit 0
}


generate()
{
	datecre=`date`

	answer=
	read -p "Do you want to use the Interface package ([y]/n)?" answer
	test -z "$answer" && answer=y
	if [ "$answer" = "y" ]
	then
		IFACE=" \$(ILFLAGS)"
	fi	
	
	answer=
	read -p "Do you want to use the GUI addon ([y]/n)?" answer
	test -z "$answer" && answer=y
	if [ "$answer" = "y" ]
	then
		GUILIB=" -l\$(GUILIB)"
	fi	
	
	answer=
	read -p "Do you want to use the shell addon (y/[n])?" answer
	test -z "$answer" && answer=n
	if [ "$answer" = "y" ]
	then
		SHELLLIB=" -l\$(SHELLLIB)"
	fi	

	answer=
	read -p "Do you want to use the crypt/digest addon (y/[n])?" answer
	test -z "$answer" && answer=n
	if [ "$answer" = "y" ]
	then
		CRYPTLIB=" -l\$(CRYPTLIB)"
	fi	

	answer=
	read -p "Do you want to build an executable, a link library or a shared library ([e]/l/s)?" answer
	test -z "$answer" && answer=e
	if [ "$answer" = "e" ]
	then
		buildcmd="\$(CC) \$(OBJECTS) -o \$(EXENAME) $GUILIB$SHELLLIB$CRYPTLIB$IFACE \$(LFLAGS)"
		cleancmd="\$(EXENAME)"
		instcmd="\$(INSTALLFILE) \$(EXENAME) \"\$(prefix)/bin\""
	fi	
	if [ "$answer" = "l" ]
	then
		buildcmd="\$(ARR) lib\$(EXENAME).a $?"
		cleancmd="lib\$(EXENAME).a"
		instcmd="\$(INSTALLFILE) lib\$(EXENAME).a \"\$(prefix)/lib\""
	fi	
	if [ "$answer" = "s" ]
	then
		buildcmd="\$(CC) $(SO_LFLAGS) -o lib\$(EXENAME).so  $GUILIB$SHELLLIB$CRYPTLIB \$(OBJECTS) \$(LFLAGS)"
		cleancmd="lib\$(EXENAME).so"
		instcmd="\$(INSTALLFILE) lib\$(EXENAME).so \"\$(prefix)/lib\""
	fi	

	echo "creating 'configure'..."
cat > configure <<EOF
#!/bin/sh
# File generated by nmo-sdk-config
# $datecre

prefix=$nmosdkprefix

#--------------------------------------------
ac_prev=
for ac_option
do
	if [ -n "\$ac_prev" ]
	then
		eval "\$ac_Prev=\\\$ac_option"
		ac_prev=
		continue
	fi

	case "\$ac_option" in
	-*=*) ac_optarg=\`echo "\$ac_option" | sed 's/[-_a-zA-Z0-9]*=//'\` ;;
	*) ac_optarg= ;;
	esac

	case "\$ac_option" in
	-help | --help | -\? | --h | -h)
		cat << EOF
Usage: configure [options]
Options: [defaults in brackets after descriptions]
    --help                  print this message.
    --prefix=DIRECTORY      use this directory for installation.
                            [\$prefix]
EOF
echo "EOF" >> configure
cat >> configure <<EOF
		exit 0;
		;;
	--prefix=*)
		prefix=\$ac_optarg
		;;	
	*)
		echo "Invalid option, try --help"
		exit 0
		;;
	esac

done

allfiles=\`find . -name Makefile.in\`
nmomk=\`nmo-sdk-config --makefile\`

for filename in \$allfiles; do
    thedir=\`dirname \$filename\`
    echo "creating \$thedir/Makefile..."
    rm -f \$thedir/Makefile
    cat > \$thedir/Makefile <<EOF
include \$nmomk
prefix=\$prefix

EOF
	echo "EOF" >> configure
	echo "cat \$thedir/Makefile.in >> \$thedir/Makefile" >> configure
	echo "touch \$thedir/.depend" >> configure
	echo "done" >> configure
	chmod +rx configure

	echo "creating 'Makefile.in'..."	
cat > Makefile.in <<EOF

# File generated by nmo-sdk-config
# $datecre

EXENAME=a.out
SRCDIR=.

OBJECTS=\$(SRCDIR)/\$(EXENAME).o \\
		\$(SRCDIR)/OtherClass.o \\

				
####### Build rules
.SUFFIXES: .cpp .o

%.o: %.cpp
	\$(CC) \$(CFLAGS) -c \$< -o \$@
	
all: \$(OBJECTS)
	$buildcmd

install:
	\$(INSTALLDIRS) \$(prefix)
	$instcmd

clean: 
	\$(RM) \$(OBJECTS) $cleancmd

distclean: clean
	\$(RM) Makefile

depend:
	\$(MKDEP) \$(CFLAGS) *.cpp

EOF
	chmod +r Makefile.in
	echo
	echo "Edit Makefile.in to match your needs."
}

ac_prev=
for ac_option
do
	if [ -n "$ac_prev" ]
	then
		eval "$ac_Prev=\$ac_option"
		ac_prev=
		continue
	fi

	case "$ac_option" in
	-*=*) ac_optarg=`echo "$ac_option" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
	*) ac_optarg= ;;
	esac

	case "$ac_option" in
	-help | --help | -\? | --h | -h)
		usage 1>&2
		exit 0;
		;;
	--prefix)
		echo $nmosdkprefix
		exit 0
		;;
	--generate)
		generate
		exit 0
		;;
	--makefile)
		echo $nmosdkmakefile
		exit 0
		;;
	--version)
		echo \$Revision\$
		exit 0;
		;;
	*)
		echo "Invalid option, try --help"
		exit 0
		;;
	esac

done

echo "try --help for options"
