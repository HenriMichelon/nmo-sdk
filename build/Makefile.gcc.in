#$Id: Makefile.gcc.in,v 1.1.1.1 2002/11/03 19:18:16 hmichelon Exp $

# archiver
ARR=$(AR) rc
# ranlib
ARS=$(AR) -st
# how to set the DT_SONAME name
SONAME=-Xlinker -soname -Xlinker

# debug/release options
ifdef DEBUG
D=d
CFLAGS?=-ggdb
CFLAGS+=-D__DEBUG
LFLAGS?=
else
D=
CFLAGS?=-O2
LFLAGS?=-s
endif 

CFLAGS+=-Wall -fexceptions -nostdinc++
LFLAGS+=-lstdc++ -lm

# how to compile a shared object/library
SO_CC=$(CC) -shared
SO_CFLAGS=
SO_LFLAGS=-shared -export-dynamic -nostartfiles

CXX=$(CC)
CXXFLAGS=$(CFLAGS)

