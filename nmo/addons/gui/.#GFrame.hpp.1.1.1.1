#ifndef _NMO_GUI_FRAME_H_
#define _NMO_GUI_FRAME_H_

namespace NMO {

/*!
\brief		A rectangular frame
 
\author		(c) 1998-2002 Henri Michelon
\version	$Id: GFrame.hpp,v 1.1.1.1 2002/11/03 19:18:16 hmichelon Exp $*/
//--------------------------------------------------------------------------

class GFrame: public GPanel
{
public:
	//! Create a GFrame widget with an optional title
	GFrame(const UStringz& = "");

	//! Return the current title of the widget
	const UStringz& Text() const;

	//! Change the title of the widget
	void SetText(const UStringz&);

private:
	UStringz	text;
};

inline const UStringz& GFrame::Text() const { return (UStringz&)text; }

}

#endif
