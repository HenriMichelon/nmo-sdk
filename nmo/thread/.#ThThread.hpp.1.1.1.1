#ifndef _NMO_MT_THREAD_H_
#define _NMO_MT_THREAD_H_

namespace NMO {
/*!
\brief		Multithreading support

			This class define a thread.
			To use it, just inherit your class and write a OnStart() event.

			Example:
			\code
			class MyClass: public ThThread {
			public:
				MyClass() {
					Start(); // Start the thread on creation
				}

			private:
				void OnStart() {
					// This event is called on thread start
					dprintf("Thread MyClass starting...\n");
				}
			};
			\endcode


\author		(c) 1999-2002 Henri Michelon
\version	$Id: ThThread.hpp,v 1.1.1.1 2002/11/03 19:18:16 hmichelon Exp $*/
//--------------------------------------------------------------------------


class ThThread: public NMOObject
{
public:
	/*! Running priority of the thread. 
		Note the REAL_TIME is implemented
		as HIGH on some OS
	*/
	typedef enum { LOW, NORMAL, HIGH, REAL_TIME } ThreadPriority;
	
	/*! Thread priority */
	typedef enum { 
		//! Thread is waiting to start
		WAITING, 
		//! Thread is currently running
		RUNNING, 
		//! Thread is finished (normally or accidentally)
		FINISHED
	} ThreadState;

	ThThread();
	virtual ~ThThread();

    /*! Run the thread.
		\return FALSE on error (generaly a lack of resources)
	*/
    _BOOL Start (ThreadPriority = NORMAL);

	/*! Wait for the end of the execution of the thread */
	void Wait();
	
	/*! Pass control to another thread (on a non-preemptive os).
		 The ending underscore is here only to make MS Visual Studio Happy
	*/
	static void Yield_();

	/*! Return the state of the thread */
	ThreadState& State();

	/*! Implement this one in your ThThread inherited classes */
	virtual void OnStart() {};

	/* Finishing thread execution.
	   Must be public for static callbacks on some OS */
	void Done();

#ifdef _MACOS
	static _DWORD gNumberOfThreads;
#endif

	_PTR mThreadAbstract;

protected:
	/*! Stop the thread (violent method !) */
	void Stop();


private:
	ThreadState state;
};


}

#endif
